{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "TimesFM-3 Workbench Job Lifecycle",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "workbench-lifecycle.lifecycle.html",
    "viewBox": [1080, 720]
  },
  "lanes": [
    { "id": "main", "label": "Job execution" },
    { "id": "interruptions", "label": "Interruptions" },
    { "id": "terminal", "label": "Terminal exits" }
  ],
  "states": [
    { "id": "queued", "type": "start", "label": "Queued", "sublabel": "validated submission", "lane": "main", "col": 0, "step": "01" },
    { "id": "running", "type": "active", "label": "Running", "sublabel": "claimed attempt", "lane": "main", "col": 1, "step": "02" },
    { "id": "succeeded", "type": "success", "label": "Succeeded", "sublabel": "result published", "lane": "main", "col": 2, "step": "03" },
    { "id": "cancelling", "type": "waiting", "label": "Cancelling", "sublabel": "cooperative stop", "lane": "interruptions", "col": 1 },
    { "id": "failed", "type": "failure", "label": "Failed", "sublabel": "unrecoverable error", "lane": "terminal", "col": 0, "yOffset": 72 },
    { "id": "retryable", "type": "waiting", "label": "Retryable", "sublabel": "retry / lease", "lane": "interruptions", "col": 2 },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "stop confirmed", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "id": "claim", "from": "queued", "to": "running", "label": "claim", "variant": "emphasis", "labelAt": [171, 202] },
    { "id": "publish", "from": "running", "to": "succeeded", "label": "publish", "variant": "emphasis", "labelDy": -25 },
    { "id": "error", "from": "running", "to": "failed", "label": "unrecoverable error", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "lease-retry", "from": "running", "to": "retryable", "label": "eligible retry / expired lease", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "retry", "from": "retryable", "to": "queued", "label": "requeue", "variant": "emphasis", "route": "top-channel" },
    { "id": "cancel-request", "from": "running", "to": "cancelling", "label": "cancel", "variant": "security", "route": "drop", "labelDy": 50 },
    { "id": "cancel-complete", "from": "cancelling", "to": "cancelled", "label": "stop confirmed", "variant": "security", "route": "bottom-channel" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Durable submission", "items": ["Validation precedes queueing", "The job and outbox entry are created atomically"] },
    { "dot": "emerald", "title": "Execution", "items": ["A worker claims the current attempt", "Heartbeats renew the lease during model work"] },
    { "dot": "rose", "title": "Recovery", "items": ["Expired leases can return to the queue", "Cancellation and unrecoverable failure are terminal exits"] }
  ]
}
